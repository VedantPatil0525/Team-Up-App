# Team-Up Backend Configuration
APP_NAME=Team-Up
APP_ENV=development
DEBUG=True
PORT=8000

# Supabase PostgreSQL Connection String
# Example: postgresql+asyncpg://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres

# Google OAuth 2.0 Client ID (Optional: for verifying Google Identity tokens)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=

# Optional Gemini API Key (for AI-assisted triage & resolution summaries)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Frontend Origins for CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

